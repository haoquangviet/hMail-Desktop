<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for hMail Desktop. Notarization requires the
  hardened runtime, and a Gecko application cannot run under it without these:
  SpiderMonkey JITs code, and the app loads its own libraries that Apple did
  not sign.

  Deliberately absent:
    com.apple.security.cs.allow-dyld-environment-variables
        Mozilla uses this in developer builds only; it weakens the runtime and
        has no place in a release build.
    com.apple.security.get-task-allow
        Debug-only. Its presence alone fails notarization.
    Restricted / provisioning-profile-backed entitlements (passkeys and the
        like) — those are bound to Mozilla's Apple Developer account and
        cannot be transferred to ours.

  build-mac.sh dumps the official Thunderbird entitlements to
  work-mac/upstream-entitlements.plist before re-signing. Diff this file
  against that dump whenever the upstream ESR is bumped.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Address book and system integration go through Apple Events. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Attachments, saved messages, address book import. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
